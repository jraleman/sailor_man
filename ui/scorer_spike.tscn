[node name="BackToDuel" type="Button" parent="Margins/Scroll/Content/Utility"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Back to duel"

[node name="OptionsLabel" type="Label" parent="Margins/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="DeviceTitle" type="Label" parent="Margins/Scroll/Content"]
layout_mode = 2
