[node name="InputDevice" type="OptionButton" parent="Margins/Scroll/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
tooltip_text = "Choose an input device before enabling capture. Microphone audio is never monitored or saved."
accessibility_description = "Choose an input device before enabling capture. Microphone audio is never monitored or saved."
fit_to_longest_item = false
text_overrun_behavior = 3

[node name="Profile" type="GridContainer" parent="Margins/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8
columns = 2

[node name="ChestLabel" type="Label" parent="Margins/Scroll/Content/Profile"]
layout_mode = 2
size_flags_horizontal = 3
text = "Chest centre (Hz)"
autowrap_mode = 3

[node name="ChestHz" type="SpinBox" parent="Margins/Scroll/Content/Profile"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 44)
layout_mode = 2
tooltip_text = "Temporary reference, not a saved calibration. Use a comfortable low pitch between 70 and 550 Hz."
accessibility_description = "Temporary reference, not a saved calibration. Use a comfortable low pitch between 70 and 550 Hz."
min_value = 70.0
max_value = 550.0
value = 160.0

[node name="CarryLabel" type="Label" parent="Margins/Scroll/Content/Profile"]
layout_mode = 2
size_flags_horizontal = 3
text = "Carrying level (RMS)"
autowrap_mode = 3

[node name="CarryLevel" type="SpinBox" parent="Margins/Scroll/Content/Profile"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 44)
layout_mode = 2
tooltip_text = "Temporary comfortable input level. Quiet Mode removes this gate; never strain to reach it."
accessibility_description = "Temporary comfortable input level. Quiet Mode removes this gate; never strain to reach it."
min_value = 0.005
max_value = 0.5
step = 0.005
value = 0.08

