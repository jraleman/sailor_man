[node name="VoiceRibbon" type="Control" parent="Margins/Scroll/Content/RemoPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 180)
layout_mode = 2
focus_mode = 2
mouse_default_cursor_shape = 2
accessibility_name = "Remo pitch ribbon"
accessibility_description = "Hold and drag to voice with buttons or touch, without a microphone. Solid line is your pitch; dashed line is the reference. Flick up for Quiebre, down for Remate. Vertical ticks show breaks; the underline shows the longest breath."
script = ExtResource("2_ribbon")

[node name="Legend" type="Label" parent="Margins/Scroll/Content"]
