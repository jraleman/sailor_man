[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_background"]
bg_color = Color(0.08, 0.13, 0.16, 0.98)

[node name="ScorerSpike" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_background")
script = ExtResource("1_script")

[node name="Margins" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 18
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 18

[node name="Scroll" type="ScrollContainer" parent="Margins"]
unique_name_in_owner = true
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Content" type="VBoxContainer" parent="Margins/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margins/Scroll/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "SAILOR MAN - VOICE / REMO SCORER"
autowrap_mode = 3

[node name="Disclaimer" type="Label" parent="Margins/Scroll/Content"]
layout_mode = 2
text = "Development spike, not a finished game. The marks are a game simplification. Real saloma recordings and cultural review are still pending. Use a comfortable voice, take breaks, and stop if singing is uncomfortable."
autowrap_mode = 3

[node name="Utility" type="HFlowContainer" parent="Margins/Scroll/Content"]
layout_mode = 2

[node name="Pause" type="Button" parent="Margins/Scroll/Content/Utility"]
unique_name_in_owner = true
