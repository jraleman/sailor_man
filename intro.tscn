[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://games/sailor_man/intro.gd" id="1_intro"]
[ext_resource type="PackedScene" path="res://games/sailor_man/gallery_stage.tscn" id="2_stage"]

[node name="SailorPracticeIntro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0745098, 0.137255, 0.160784, 1)

[node name="Margins" type="MarginContainer" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Layout" type="VBoxContainer" parent="Margins"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margins/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Margins/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Sailor Man"

[node name="Step" type="Label" parent="Margins/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "1 / 3"
horizontal_alignment = 2

[node name="Body" type="BoxContainer" parent="Margins/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="Stage" parent="Margins/Layout/Body" instance=ExtResource("2_stage")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
accessibility_name = "Original practice models"

[node name="CopyScroll" type="ScrollContainer" parent="Margins/Layout/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
focus_mode = 2
horizontal_scroll_mode = 0
follow_focus = true
accessibility_name = "Practice opening text"
accessibility_description = "Read at your own pace. Scroll for more text; Next advances and Skip opens the title screen. Controller: D-pad up/down scrolls, left/right selects Skip/Next, A activates and B skips."

[node name="CopyColumn" type="VBoxContainer" parent="Margins/Layout/Body/CopyScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Heading" type="Label" parent="Margins/Layout/Body/CopyScroll/CopyColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
autowrap_mode = 2

[node name="Copy" type="Label" parent="Margins/Layout/Body/CopyScroll/CopyColumn"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 16
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Margins/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="SkipButton" type="Button" parent="Margins/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 44)
theme_type_variation = &"NavigationButton"
theme_override_font_sizes/font_size = 18
text = "Skip"
tooltip_text = "Skip the opening and go to the title screen."
accessibility_description = "Skip the opening and go to the title screen."

[node name="NextButton" type="Button" parent="Margins/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 44)
theme_type_variation = &"NavigationButton"
theme_override_font_sizes/font_size = 18
text = "Next"

[connection signal="pressed" from="Margins/Layout/Actions/SkipButton" to="." method="_on_skip_pressed"]
[connection signal="pressed" from="Margins/Layout/Actions/NextButton" to="." method="_on_next_pressed"]
